# ─── Supabase (required) ───────────────────────────────────────────────────────
# Copy from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY
# Server-only secret. Do not prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# ─── Admin credentials ────────────────────────────────────────────────────────
# Used to auto-create the first admin record in Supabase on first login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# ─── Server port (optional, default 4000) ────────────────────────────────────
PORT=4000
